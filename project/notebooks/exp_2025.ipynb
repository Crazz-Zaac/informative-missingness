    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def map_race(race):\n",
    "    \"\"\"Map race to only 4 categories: White, Black, Asian, Other\"\"\"\n",
    "    if pd.isna(race):\n",
    "        return 'Other'\n",
    "    \n",
    "    race = str(race).upper()\n",
    "    \n",
    "    if 'WHITE' in race:\n",
    "        return 'White'\n",
    "    elif 'BLACK' in race or 'AFRICAN' in race:\n",
    "        return 'Black'\n",
    "    elif 'ASIAN' in race:\n",
    "        return 'Asian'\n",
    "    else:\n",
    "        # Everything else goes to 'Other'\n",
    "        return 'Other'\n",
    "\n",
    "def calculate_demographic_statistics(df, age_threshold=50):\n",
    "    \"\"\"\n",
    "    Calculate demographic statistics for the dataset with race mapping\n",
    "    \n",
    "    Parameters:\n",
    "    df: DataFrame with the required columns\n",
    "    age_threshold: Age threshold for grouping (default: 65)\n",
    "    \"\"\"\n",
    "    \n",
    "    # Create a copy to avoid modifying the original dataframe\n",
    "    df_processed = df.copy()\n",
    "    \n",
    "    # Apply race mapping\n",
    "    df_processed['race_group'] = df_processed['race'].apply(map_race)\n",
    "    \n",
    "    results = {}\n",
    "    \n",
    "    # 1. Number of admissions\n",
    "    results['total_admissions'] = df_processed['hadm_id'].nunique()\n",
    "    \n",
    "    # 2. Number of patients\n",
    "    results['total_patients'] = df_processed['subject_id'].nunique()\n",
    "    \n",
    "    # 3. Number of admissions with positive and negative clinical outcome\n",
    "    outcome_counts = df_processed.groupby('hadm_id')['target'].first().value_counts()\n",
    "    results['admissions_positive_outcome'] = outcome_counts.get(1, 0)\n",
    "    results['admissions_negative_outcome'] = outcome_counts.get(0, 0)\n",
    "    \n",
    "    # 4. Number of patients per gender\n",
    "    gender_counts = df_processed.groupby('subject_id')['gender'].first().value_counts()\n",
    "    results['patients_per_gender'] = gender_counts.to_dict()\n",
    "    \n",
    "    # 5. Number of patients per race group (using mapped races)\n",
    "    race_counts = df_processed.groupby('subject_id')['race_group'].first().value_counts()\n",
    "    results['patients_per_race_group'] = race_counts.to_dict()\n",
    "    \n",
    "    # 6. Also keep original race distribution for reference\n",
    "    original_race_counts = df_processed.groupby('subject_id')['race'].first().value_counts()\n",
    "    results['patients_per_original_race'] = original_race_counts.to_dict()\n",
    "    \n",
    "    # 7. Number of patients in each age group\n",
    "    patient_ages = df_processed.groupby('subject_id')['anchor_age'].first()\n",
    "    age_groups = pd.cut(patient_ages, \n",
    "                       bins=[0, age_threshold, 120], \n",
    "                       labels=[f'≤{age_threshold}', f'>{age_threshold}'])\n",
    "    results['patients_per_age_group'] = age_groups.value_counts().to_dict()\n",
    "    \n",
    "    # Additional statistics\n",
    "    results['average_age'] = patient_ages.mean()\n",
    "    results['age_std'] = patient_ages.std()\n",
    "    results['min_age'] = patient_ages.min()\n",
    "    results['max_age'] = patient_ages.max()\n",
    "    \n",
    "    return results\n",
    "\n",
    "def print_demographic_report(df, age_threshold=50):\n",
    "    \"\"\"Print a formatted demographic report with race mapping\"\"\"\n",
    "    \n",
    "    stats = calculate_demographic_statistics(df, age_threshold)\n",
    "    \n",
    "    print(\"=\" * 60)\n",
    "    print(\"DEMOGRAPHIC STATISTICS REPORT (with Race Mapping)\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    print(f\"\\n1. Admissions and Patients:\")\n",
    "    print(f\"   Total Admissions: {stats['total_admissions']:,}\")\n",
    "    print(f\"   Total Patients: {stats['total_patients']:,}\")\n",
    "    \n",
    "    print(f\"\\n2. Clinical Outcomes:\")\n",
    "    print(f\"   Admissions with Positive Outcome: {stats['admissions_positive_outcome']:,}\")\n",
    "    print(f\"   Admissions with Negative Outcome: {stats['admissions_negative_outcome']:,}\")\n",
    "    if stats['total_admissions'] > 0:\n",
    "        positive_rate = (stats['admissions_positive_outcome']/stats['total_admissions']*100)\n",
    "        print(f\"   Positive Outcome Rate: {positive_rate:.1f}%\")\n",
    "    \n",
    "    print(f\"\\n3. Gender Distribution:\")\n",
    "    for gender, count in stats['patients_per_gender'].items():\n",
    "        percentage = (count / stats['total_patients']) * 100\n",
    "        print(f\"   {gender}: {count:,} ({percentage:.1f}%)\")\n",
    "    \n",
    "    print(f\"\\n4. Race Group Distribution (Mapped):\")\n",
    "    for race_group, count in stats['patients_per_race_group'].items():\n",
    "        percentage = (count / stats['total_patients']) * 100\n",
    "        print(f\"   {race_group}: {count:,} ({percentage:.1f}%)\")\n",
    "    \n",
    "    print(f\"\\n5. Age Distribution (Threshold: {age_threshold} years):\")\n",
    "    for age_group, count in stats['patients_per_age_group'].items():\n",
    "        percentage = (count / stats['total_patients']) * 100\n",
    "        print(f\"   {age_group} years: {count:,} ({percentage:.1f}%)\")\n",
    "    \n",
    "    print(f\"\\n6. Age Statistics:\")\n",
    "    print(f\"   Average Age: {stats['average_age']:.1f} ± {stats['age_std']:.1f} years\")\n",
    "    print(f\"   Age Range: {stats['min_age']} - {stats['max_age']} years\")\n",
    "    \n",
    "    return stats\n",
    "\n",
    "# Additional function to see the mapping results\n",
    "def analyze_race_mapping(df):\n",
    "    \"\"\"Analyze how race values are being mapped\"\"\"\n",
    "    df_temp = df.copy()\n",
    "    df_temp['mapped_race'] = df_temp['race'].apply(map_race)\n",
    "    \n",
    "    print(\"Race Mapping Analysis:\")\n",
    "    print(\"=\" * 40)\n",
    "    \n",
    "    # Show original vs mapped distribution\n",
    "    mapping_results = df_temp.groupby(['race', 'mapped_race']).size().reset_index(name='count')\n",
    "    print(\"\\nOriginal Race -> Mapped Race Group:\")\n",
    "    for _, row in mapping_results.iterrows():\n",
    "        print(f\"  '{row['race']}' -> '{row['mapped_race']}': {row['count']} records\")\n",
    "    \n",
    "    return mapping_results\n",
    "\n",
    "# Usage example:\n",
    "# df = pd.read_csv('your_data.csv')\n",
    "demographic_stats = calculate_demographic_statistics(nf_df)\n",
    "print_demographic_report(nf_df)\n",
    "\n",
    "# To analyze the race mapping:\n",
    "race_mapping_analysis = analyze_race_mapping(nf_df)"
   ]
  },
