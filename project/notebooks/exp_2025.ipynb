    "# Define discretization bins (e.g., 12-hour intervals)\n",
    "start_time = df[\"charttime\"].min()\n",
    "end_time = df[\"charttime\"].max()\n",
    "bins = pd.date_range(start=start_time.floor('D'), end=end_time.ceil('D'), freq=\"12h\")  # 12-hour bins\n",
    "\n",
    "df[\"time_bin\"] = pd.cut(df[\"charttime\"], bins=bins, labels=bins[:-1])\n",
    "\n",
    "# Dynamically assign colors per itemid\n",
    "unique_items = df[\"itemid\"].unique()\n",
    "colors_map = px.colors.qualitative.Plotly\n",
    "if len(unique_items) > len(colors_map):\n",
    "    import matplotlib.pyplot as plt\n",
    "    import matplotlib\n",
    "    cmap = plt.get_cmap(\"tab20\")\n",
    "    colors_map = [matplotlib.colors.rgb2hex(cmap(i/len(unique_items))) for i in range(len(unique_items))]\n",
    "itemid_to_color = {item: colors_map[i] for i, item in enumerate(unique_items)}\n",
    "\n",
    "# Create discretized scatter plot\n",
    "fig = go.Figure()\n",
    "for i, row in df.iterrows():\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=[row[\"time_bin\"]],\n",
    "        y=[row[\"itemid\"]],\n",
    "        mode=\"markers+text\",\n",
    "        text=[row[\"valuenum\"]],\n",
    "        textposition=\"middle center\",\n",
    "        marker=dict(size=40, color=itemid_to_color[row[\"itemid\"]], line=dict(width=2, color=\"darkblue\")),\n",
    "        textfont=dict(color=\"black\", size=12),\n",
    "        name=f\"Item {row['itemid']}\"\n",
    "    ))\n",
    "\n",
    "# Layout\n",
    "fig.update_layout(\n",
    "    title=\"Discretized MIMIC-IV Time Series (Missingness Representation)\",\n",
    "    xaxis_title=\"Time Bin\",\n",
    "    yaxis_title=\"Item ID\",\n",
    "    template=\"simple_white\",\n",
    "    xaxis=dict(showgrid=True),\n",
    "    legend_title=\"Item ID\"\n",
    ")\n",
    "\n",
    "# Save as PDF\n",
    "fig.write_image(\"mimic_timeseries_discretized.pdf\")"
