@startuml
' Use vertical layout
top to bottom direction

' caption Figure 1: Machine Learning Training Pipeline Architecture
' title Code Base Overview

package "src" {
  package "config" {
    class schemas
  }

  package "data" {
    class data_loader
    class data_preprocessing
    class dataset
    class tabular_data_processor
  }

  package "models" {
    class xgboost
    class catboost
    class random_forest
    class logistic_regression
    class gradient_boosting
  }

  package "training" {
    class train_xgboost
    class train_catboost
    class train_rf
    class train_logistic_regression
    class train_gradboost
    class logger
  }

  package "utils" {
    class logging_utils
  }
}

package "dataset" {
    package "preprocessed_tabular" {}
    package "raw" {}
}

' Relationships
config.schemas --> data.data_loader : load yaml configs
data.dataset --> data.data_loader : read configs
data.data_preprocessing --> dataset.preprocessed_tabular : load processed data

training.train_xgboost --> models.xgboost : uses
training.train_catboost --> models.catboost : uses
training.train_rf --> models.random_forest : uses
training.train_logistic_regression --> models.logistic_regression : uses
training.train_gradboost --> models.gradient_boosting : uses

training.train_xgboost <-- data.data_preprocessing : trains on
training.train_catboost <-- data.data_preprocessing : trains on
training.train_rf <-- data.data_preprocessing : trains on
training.train_logistic_regression <-- data.data_preprocessing : trains on
training.train_gradboost <-- data.data_preprocessing : trains on

' Notes
note left of config.schemas
  Defines data schemas
  and pydantic validation rules
  for input data and variables
end note

@enduml
