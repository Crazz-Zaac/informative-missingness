    "import pandas as pd\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "\n",
    "df[\"charttime\"] = pd.to_datetime(df[\"charttime\"], errors=\"coerce\")\n",
    "\n",
    "# Dynamically assign a color to each itemid\n",
    "unique_items = df[\"itemid\"].unique()\n",
    "colors_map = px.colors.qualitative.Plotly\n",
    "if len(unique_items) > len(colors_map):\n",
    "    import matplotlib.pyplot as plt\n",
    "    import matplotlib\n",
    "    cmap = plt.get_cmap(\"tab20\")\n",
    "    colors_map = [matplotlib.colors.rgb2hex(cmap(i/len(unique_items))) for i in range(len(unique_items))]\n",
    "itemid_to_color = {item: colors_map[i] for i, item in enumerate(unique_items)}\n",
    "\n",
    "# Create scatter plot\n",
    "fig = go.Figure()\n",
    "for i, row in df.iterrows():\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=[row[\"charttime\"]],\n",
    "        y=[row[\"valuenum\"]],\n",
    "        mode=\"markers+text\",\n",
    "        text=[row[\"valuenum\"]],\n",
    "        textposition=\"middle center\",\n",
    "        marker=dict(size=40, color=itemid_to_color[row[\"itemid\"]], line=dict(width=2, color=\"darkblue\")),\n",
    "        textfont=dict(color=\"black\", size=12),\n",
    "        name=f\"Item {row['itemid']}\"  # legend\n",
    "    ))\n",
    "\n",
    "# Layout\n",
    "fig.update_layout(\n",
    "    title=\"MIMIC-IV Lab/Measurement Time Series\",\n",
    "    xaxis_title=\"Chart Time\",\n",
    "    yaxis_title=\"Value\",\n",
    "    template=\"simple_white\",\n",
    "    xaxis=dict(showgrid=True),\n",
    "    legend_title=\"Item ID\"\n",
    ")\n",
    "\n",
    "# Save as PDF\n",
    "fig.write_image(\"mimic_timeseries_charttime.pdf\")\n"
   ]
  },
